# ─────────────────────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────────────────────
.DS_Store
._*

# ─────────────────────────────────────────────────────────────
# Figma 匯入用的產生物
#   跑 python3 docs/ui/mockups/tools/figma_prep.py 就能重建。
#   dist/ 底下的三份 .md（匯入操作清單、frame命名對照表、lint-report）
#   要進版控 —— 組員要在 GitHub 上直接讀。
#   只擋 zip 與內聯 HTML 這兩包純衍生物（約 1.5MB）。
# ─────────────────────────────────────────────────────────────
docs/ui/mockups/dist/A-zip/
docs/ui/mockups/dist/B-inlined/

# Figma 外掛的 code.js 是 layout.json + code.template.js 合成的，
# 跑 tools/figma-plugin/build_plugin.py 一秒就重建。
# layout.json 本身要進版控 —— 它是量測結果，沒有 Playwright 的人重現不出來。
docs/ui/mockups/tools/figma-plugin/code.js

# ─────────────────────────────────────────────────────────────
# Java / Spring Boot
# ─────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
hs_err_pid*.log

# ─────────────────────────────────────────────────────────────
# Node / React
# ─────────────────────────────────────────────────────────────
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端 build 產出：等 src/ 結構定了再補正確路徑，例如
#   src/main/frontend/dist/
# ★ 不要寫成裸的 dist/ ——
#   那會把 docs/ui/mockups/dist/ 底下要進版控的 .md 一起擋掉。

# ─────────────────────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
.settings/
.project
.classpath

# ─────────────────────────────────────────────────────────────
# 環境變數與機密（絕對不要進版控）
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ★ 例外：前端的 Vite env 檔要進版控
#   Vite 只把 VITE_ 開頭的變數送進前端，而那些變數打包後就寫在 JS 檔裡、
#   按 F12 就看得到 —— 依設計它們就是公開的，本來就不該放機密。
#   反過來說這兩個檔必須進版控，否則組員 clone 下來沒有設定，
#   VITE_API_BASE 會是 undefined 而且不會報錯。
#   個人覆蓋用 .env.*.local，那個仍然被上面的 .env.* 擋著。
#   後端（Spring Boot）的 .env 照樣擋，那裡才是真的有資料庫密碼的地方。
!frontend/.env.development
!frontend/.env.production

# ─────────────────────────────────────────────────────────────
# 其他
# ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
