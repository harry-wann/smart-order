# 複製這份成 backend/.env，再把每一項換成自己的值。backend/.env 不會被 commit。
#   cp backend/.env.example backend/.env
#
# 連本機或連遠端（smartorder 與 northwind 各自獨立，可以一個連本機、一個連遠端）：
#   ・連本機 MySQL：保留沒有 # 的那行 URL（127.0.0.1），遠端那行維持 # 開頭；帳密填你本機 MySQL 的帳號。
#   ・連遠端共用 MySQL：在本機那行前面加 #，拿掉遠端那行前面的 #；帳密填遠端的帳號（跟 Harry 拿）。
#     遠端主機在 Tailscale 網路裡，要先登入 Tailscale 才連得到。
#   ・改完 .env 要重新啟動後端伺服器才會生效。

# ============================================================================
# smartorder：專題本身的資料庫
# 建表與假資料見 backend/db/README.md
# ============================================================================

# smartorder 的 JDBC 連線網址，下面兩行只能留一行沒有 #：
#   ・第一行連本機：埠號換成你本機 MySQL 實際使用的 port（自己安裝的 MySQL 通常是 3306；
#     MAMP 請填 MAMP 設定裡 MySQL 的 port 號）
#   ・第二行連遠端共用 MySQL：主機與埠號已經填好，不用改
# 資料庫名稱 smartorder 與 ? 後面的參數不要改。
SMARTORDER_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/smartorder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
# SMARTORDER_DATASOURCE_URL=jdbc:mysql://desktop-i6tmm2c.taild9202f.ts.net:7775/smartorder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8

# 連 smartorder 用的帳號。連本機填你在本機 MySQL（MAMP 或自己安裝）建好的帳號；連遠端填遠端的帳號。不要填 root。
SMARTORDER_DATASOURCE_USERNAME=

# 上面那個帳號的密碼。
SMARTORDER_DATASOURCE_PASSWORD=

# ============================================================================
# northwind：只給 /api/northwind/** 的範例 API 用
# ============================================================================

# northwind 的 JDBC 連線網址，跟 smartorder 一樣兩行只能留一行沒有 #；連本機或遠端跟 smartorder 那組無關，可以分開選。
#   ・第一行連本機：埠號換成你本機 MySQL 實際使用的 port（MAMP 請填 MAMP 設定裡 MySQL 的 port 號）
#   ・第二行連遠端共用 MySQL：主機與埠號已經填好，不用改
# 資料庫名稱 northwind 與 ? 後面的參數不要改。
NORTHWIND_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/northwind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
# NORTHWIND_DATASOURCE_URL=jdbc:mysql://desktop-i6tmm2c.taild9202f.ts.net:7775/northwind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8

# 連 northwind 用的帳號。跟 smartorder 連同一邊（都本機或都遠端）時，通常跟 SMARTORDER_DATASOURCE_USERNAME 一樣；連不同邊就各填各的。
NORTHWIND_DATASOURCE_USERNAME=

# 上面那個帳號的密碼。
NORTHWIND_DATASOURCE_PASSWORD=

# ============================================================================
# Cloudflare R2 圖片上傳（選填；實際金鑰只放在 backend/.env）
# ============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smart-order-menu-images
R2_STAGING_BUCKET_NAME=smart-order-menu-staging
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_MAX_UPLOAD_BYTES=5242880
# 簽發、確認上傳只給登入的店長（MANAGER），沒有匿名開關。

# ============================================================================
# 其他（選填）
# ============================================================================

# 員工登入的 JWT 金鑰。只在本機開發時可以不填（用內建的開發金鑰）；
# 共用或部署環境一定要填，至少 32 字元，例如用 `openssl rand -base64 48` 產生。
# STAFF_JWT_SECRET=

# 會員登入、同桌點餐（掃碼加入桌位）的 JWT 金鑰。規則跟 STAFF_JWT_SECRET 一樣：只在本機開發時可以不填；
# 共用或部署環境一定要填，至少 32 字元，而且要跟 STAFF_JWT_SECRET 不同把，例如用 `openssl rand -base64 48` 產生。
# 換了金鑰，已登入的會員要重新登入、正在用餐的客人要重新掃碼。
# CUSTOMER_JWT_SECRET=

# 會員登入（工作包 A）做好之前，訂位的會員流程用 mock 權杖。只在本機開發時打開。
MEMBER_MOCK_ENABLED=true

# 允許呼叫 API 的前端網址，多個用逗號分隔。不填就是 http://localhost:5173（npm run dev 的預設網址）。
# 用手機連電腦測試時，把電腦的區網 IP 加進來，例如：
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.23:5173

# 綠界測試環境（選填）；全部設定完整才顯示線上付款。
# 只允許測試付款頁，不要在此填正式環境或真實金鑰。
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ACTION_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_RETURN_URL=
ECPAY_CLIENT_BACK_URL=
