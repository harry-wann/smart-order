# 以下 MYSQL_* 僅供 Docker Compose 初始化使用；MAMP／自行安裝 MySQL 可忽略或移除。
# MySQL root 管理員密碼；root 擁有完整資料庫權限，僅供管理與初始化使用。
MYSQL_ROOT_PASSWORD=change_this_root_password

# MySQL 第一次初始化時建立的資料庫名稱；這裡建立 northwind，smartorder 由 docker/mysql-init 另外建立。
MYSQL_DATABASE=northwind

# 提供 Spring Boot 使用的一般 MySQL 帳號；不要填 root。Docker Compose 會讓它同時擁有兩個資料庫的權限。
MYSQL_USER=spring

# 上述一般 MySQL 帳號的密碼；Spring Boot 連線時會使用這個密碼。
MYSQL_PASSWORD=change_this_app_password

# Spring Boot 連兩個資料庫：smartorder 是專題本身的資料庫，northwind 只給 demo API 用。
# MAMP／自行安裝 MySQL：填入實際埠號、已建立的帳號與密碼；MAMP 的 MySQL 若為 8889，請改 URL。
# Docker Compose：沿用 3306，並讓帳密與上方 MYSQL_USER／MYSQL_PASSWORD 一致。
SMARTORDER_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/smartorder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
SMARTORDER_DATASOURCE_USERNAME=spring
SMARTORDER_DATASOURCE_PASSWORD=change_this_app_password

NORTHWIND_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/northwind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
NORTHWIND_DATASOURCE_USERNAME=spring
NORTHWIND_DATASOURCE_PASSWORD=change_this_app_password

# 允許跨來源呼叫 API 的前端網址；多個用逗號分隔。不填則預設 http://localhost:5173。
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.23:5173
