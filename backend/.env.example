# 以下 MYSQL_* 僅供 Docker Compose 初始化使用；MAMP／自行安裝 MySQL 可忽略或移除。
# MySQL root 管理員密碼；root 擁有完整資料庫權限，僅供管理與初始化使用。
MYSQL_ROOT_PASSWORD=change_this_root_password

# MySQL 第一次初始化時建立的資料庫名稱；本課使用 northwind。
MYSQL_DATABASE=northwind

# 提供 Spring Boot 使用的一般 MySQL 帳號；不要填 root。
MYSQL_USER=spring

# 上述一般 MySQL 帳號的密碼；Spring Boot 連線時會使用這個密碼。
MYSQL_PASSWORD=change_this_app_password

# 所有方案的 Spring Boot 都使用以下三個連線設定。
# MAMP／自行安裝 MySQL：填入實際埠號、已建立的帳號與密碼；MAMP 的 MySQL 若為 8889，請改 URL。
# Docker Compose：沿用 3306，並讓帳密與上方 MYSQL_USER／MYSQL_PASSWORD 一致。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/northwind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=spring
SPRING_DATASOURCE_PASSWORD=change_this_app_password
