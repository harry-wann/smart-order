{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "generate:icons": "node scripts/generate-icon-map.mjs",
    "predev": "npm run generate:icons",
    "dev": "vite",
    "prebuild": "npm run generate:icons",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write . && npm run format:js && npm run format:js",
    "format:js": "oxlint -c oxlint.format.config.ts --fix --quiet",
    "format:check": "prettier --check . && oxlint -c oxlint.format.config.ts --deny-warnings",
    "pretypecheck": "npm run generate:icons",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
