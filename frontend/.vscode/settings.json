{
  // ── Tailwind ──────────────────────────────────────────────
  // class 寫在 className="..." 的字串裡，VS Code 預設不在字串內跳自動完成
  // 沒有這行，Tailwind IntelliSense 看起來像壞掉
  "editor.quickSuggestions": { "strings": "on" },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // ── JS / TS 存檔格式化 ─────────────────────────────────────
  // CSS / HTML / JSON 存檔時仍由上面的 Prettier 處理。
  // JS / TS 不用 Prettier：它會把自己打的換行、空行、註解對齊用的空白清掉（沒有選項可關）。
  // 改成存檔時由 oxlint 套用 oxlint.format.config.ts 的格式規則，一樣是存檔自動排版，
  // 只是沒列在規則裡的東西（換行、空行、行尾空白）不會被動到
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },

  // 編輯器讀 lint + 格式化合併後的設定；npm run lint 與 CI 仍讀 .oxlintrc.json
  "oxc.configPath": "oxlint.editor.config.ts",

  // 格式問題存檔就會自動修掉，不需要整片黃色波浪線。
  // 降成 hint 後只剩不顯眼的提示，也不會出現在「問題」面板（存檔自動修正不受影響）。
  // oxlint.format.config.ts 新增規則時，這裡要跟著加一行，否則那條會顯示成警告
  "oxc.lint.customization": {
    "@stylistic/indent": { "severity": "hint" },
    "@stylistic/jsx-indent-props": { "severity": "hint" },
    "@stylistic/quotes": { "severity": "hint" },
    "@stylistic/jsx-quotes": { "severity": "hint" },
    "@stylistic/semi": { "severity": "hint" },
    "@stylistic/comma-dangle": { "severity": "hint" },
    "@stylistic/arrow-parens": { "severity": "hint" },
    "@stylistic/no-multi-spaces": { "severity": "hint" },
    "@stylistic/object-curly-spacing": { "severity": "hint" },
    "@stylistic/array-bracket-spacing": { "severity": "hint" },
    "@stylistic/comma-spacing": { "severity": "hint" },
    "@stylistic/key-spacing": { "severity": "hint" },
    "@stylistic/keyword-spacing": { "severity": "hint" },
    "@stylistic/space-before-blocks": { "severity": "hint" },
    "@stylistic/space-infix-ops": { "severity": "hint" },
    "@stylistic/arrow-spacing": { "severity": "hint" },
    "@stylistic/space-in-parens": { "severity": "hint" },
    "@stylistic/space-before-function-paren": { "severity": "hint" },
    "@stylistic/block-spacing": { "severity": "hint" },
    "@stylistic/semi-spacing": { "severity": "hint" },
    "@stylistic/template-curly-spacing": { "severity": "hint" },
    "@stylistic/type-annotation-spacing": { "severity": "hint" },
    "@stylistic/jsx-tag-spacing": { "severity": "hint" },
    "@stylistic/jsx-curly-spacing": { "severity": "hint" },
    "@stylistic/jsx-equals-spacing": { "severity": "hint" },
    "@stylistic/eol-last": { "severity": "hint" },
    "better-tailwindcss/enforce-consistent-class-order": { "severity": "hint" }
  },

  // @theme / @utility 是 Tailwind v4 的語法，不是標準 CSS，
  // VS Code 內建的 CSS 檢查器不認得，會報 "Unknown at rule"。那不是錯誤，build 正常
  "css.lint.unknownAtRules": "ignore",

  // ── JSX ───────────────────────────────────────────────────
  // 改開頭標籤，結尾標籤自動跟著改
  "editor.linkedEditing": true,

  // 在 .jsx 裡用 Emmet：打 div.flex.items-center 按 Tab
  // → <div className="flex items-center"></div>（知道要用 className 不是 class）
  "emmet.includeLanguages": { "javascript": "javascriptreact" },

  // ── 縮排 ──────────────────────────────────────────────────
  // JS / React 慣例是 2 格（Java 是 4）。JSX 巢狀深，4 格很快撞到行寬
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false
}
