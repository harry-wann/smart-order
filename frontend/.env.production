# 正式環境（npm run build 會讀這個檔）
#
# 規則與說明見 .env.development，這裡只列值。
#
# ★ 為什麼 VITE_USE_MOCK 一定是 false：
#   因為是 build 時替換，USE_MOCK 會被折成常數 false，
#   整條 mock 分支變成死碼被搖掉，假資料不會進 production bundle。
#   反過來說這裡若寫成 true，假資料就會跟著上線。

VITE_USE_MOCK=false

# 前端與後端同網域部署，用相對路徑即可（部署方式見 tech/quality/50-部署上線）。
VITE_API_BASE=/api

# 空字串代表「跟目前網頁同一個 host，並依 http/https 自動選 ws/wss」，
# 由 services/realtime/socket.js 組出完整網址。
VITE_WS_URL=
